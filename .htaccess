# ==============================================================================
# Python4Physics - Apache Web Server Optimization, Security & Anti-Cloning Rules
# ==============================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce HTTPS and canonical non-www domain on live production (301 Permanent Redirect)
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,NE,R=301]

    # Block access to hidden files and directories (e.g. .git, .env, .gitignore)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Block automated offline website copiers, rippers & bulk scrapers
    RewriteCond %{HTTP_USER_AGENT} (HTTrack|Teleport|WebCopier|Offline\ Explorer|Website\ Ripper|SiteSucker|SuperBot|WebAuto|BlackWidow|WebReaper|PageGrabber|WebSauger) [NC]
    RewriteRule ^.*$ - [F,L]

    # Dynamic route for XML sitemap
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Block direct web downloads of source control, databases, backups, scripts, and configs
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|env|ini|yml|yaml|bat|py|ipynb)|composer\.(json|lock)|package(-lock)?\.json|~)$">
    Require all denied
</FilesMatch>

# MIME Types for Mathematical & Modern Web Assets
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
    AddEncoding gzip .svgz
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType text/plain .dat .txt
</IfModule>

# Gzip / Brotli Compression for Fast Page Speed (Core Web Vitals)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching Headers for High Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
