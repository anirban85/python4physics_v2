# Python4Physics Git Attributes
# Enforce UNIX LF line endings across all platforms to prevent merge conflicts
* text=auto eol=lf

*.php text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.htaccess text eol=lf
*.svg text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
